{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/documents/**",
              "ui_kits/teacherbot/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Michroma|Titillium Web|JetBrains Mono|Source Sans 3|Source Serif 4))/i]",
        "message": "Font not provided by the design system. Available: Michroma, Titillium Web, JetBrains Mono, Source Sans 3, Source Serif 4."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|info|success|warning|danger|navy)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'info' | 'success' | 'warning' | 'danger' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:mark|height|base|invert|style|key|ref|className|style|children)$/]",
        "message": "<BrandMark> doesn't accept that prop. Declared props: mark, height, base, invert, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute[name.name='mark'] > Literal[value!=/^(?:logo-eye|logo-alx|lettermark|eye|eye-notcult|alx|heptagram|heptagram-gradient|heptagram-flow)$/]",
        "message": "<BrandMark> mark must be one of 'logo-eye' | 'logo-alx' | 'lettermark' | 'eye' | 'eye-notcult' | 'alx' | 'heptagram' | 'heptagram-gradient' | 'heptagram-flow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger|gold)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:spine|tag|title|footer|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: spine, tag, title, footer, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClearanceBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:band|outline|style|key|ref|className|style|children)$/]",
        "message": "<ClearanceBadge> doesn't accept that prop. Declared props: band, outline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClearanceBadge'] > JSXAttribute[name.name='band'] > Literal[value!=/^(?:INFRARED|RED|ORANGE|YELLOW|GREEN|BLUE|INDIGO|VIOLET|ULTRAVIOLET|GRAY)$/]",
        "message": "<ClearanceBadge> band must be one of 'INFRARED' | 'RED' | 'ORANGE' | 'YELLOW' | 'GREEN' | 'BLUE' | 'INDIGO' | 'VIOLET' | 'ULTRAVIOLET' | 'GRAY'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClearanceLadder'] > JSXAttribute > JSXIdentifier[name!=/^(?:rungs|style|key|ref|className|style|children)$/]",
        "message": "<ClearanceLadder> doesn't accept that prop. Declared props: rungs, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|style|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: columns, rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|kicker|onClose|actions|children|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, kicker, onClose, actions, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FinePrint'] > JSXAttribute > JSXIdentifier[name!=/^(?:slogan|dark|children|style|key|ref|className|style|children)$/]",
        "message": "<FinePrint> doesn't accept that prop. Declared props: slogan, dark, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|mono|placeholder|value|onChange|type|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, mono, placeholder, value, onChange, type, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KPI'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|caption|dark|style|key|ref|className|style|children)$/]",
        "message": "<KPI> doesn't accept that prop. Declared props: value, unit, caption, dark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options, value, onChange, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|fig|note|segments|child|dark|style|key|ref|className|style|children)$/]",
        "message": "<StatBar> doesn't accept that prop. Declared props: name, fig, note, segments, child, dark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|dark|style|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: status, dark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:critical|warning|ok|none)$/]",
        "message": "<StatusDot> status must be one of 'critical' | 'warning' | 'ok' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StripeRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|angle|gap|width|style|key|ref|className|style|children)$/]",
        "message": "<StripeRail> doesn't accept that prop. Declared props: height, angle, gap, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|active|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, active, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: tone, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|warning|danger)$/]",
        "message": "<Toast> tone must be one of 'info' | 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: label, children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
